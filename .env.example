# OpenAI API key (required for OpenAI provider)
CHATGPT_API_KEY=sk-your-key-here

# Model for search queries (optional)
# PAGEINDEX_MODEL=gpt-4o-2024-11-20

# For OpenAI-compatible APIs (optional)
# PAGEINDEX_BASE_URL=http://localhost:11434/v1

# ── Amazon Bedrock Configuration ──────────────────────────────────

# Option A: Bedrock API key (recommended, no boto3 needed)
# Get one from the Bedrock console → API keys
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# AWS_REGION=us-west-2

# Option B: IAM credentials via boto3
# PAGEINDEX_PROVIDER=bedrock
# AWS_REGION=us-west-2
# (uses standard boto3 credential chain: env vars, ~/.aws/credentials, IAM role)

# Override Bedrock model ID (default: anthropic.claude-3-5-sonnet-20241022-v2:0)
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Friendly model names also work:
# PAGEINDEX_MODEL=claude-3.5-sonnet
# PAGEINDEX_MODEL=claude-3.5-haiku
